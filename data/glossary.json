{
 "terms": [
  {
   "id": "cross-sensory-correspondence",
   "term": "Cross-Sensory Correspondence",
   "definition": "A steady, non-random link between something in one sense and something in another, such as a spiky shape and a sharp-sounding word."
  },
  {
   "id": "bouba-kiki-effect",
   "term": "Bouba–Kiki Effect",
   "definition": "The common finding that people link spiky shapes with the made-up word “kiki” and round shapes with “bouba.”"
  },
  {
   "id": "olfaction",
   "term": "Olfaction / Olfactory",
   "definition": "The sense of smell."
  },
  {
   "id": "tactile",
   "term": "Tactile",
   "definition": "Having to do with touch."
  },
  {
   "id": "valence",
   "term": "Valence",
   "definition": "How good or bad something feels. In this paper, a child saying “I love it” is a valence reason."
  },
  {
   "id": "arousal",
   "term": "Arousal",
   "definition": "How energized a feeling is, from calm to excited."
  },
  {
   "id": "anthropomorphic",
   "term": "Anthropomorphic",
   "definition": "Given human traits. The shapes were treated as characters."
  },
  {
   "id": "stimulus",
   "term": "Stimulus (Plural: Stimuli)",
   "definition": "Something presented to a participant to get a response, such as a shape or a scent."
  },
  {
   "id": "association-strategy",
   "term": "Association Strategy",
   "definition": "The kind of reason a child gives for a match. The paper uses seven kinds: Embodied Action, Grasping for Another Sense, Personal Connection, Sensory Features, Valence, Vocalisation and Familiar Experience."
  },
  {
   "id": "chi-square-test",
   "term": "Chi-Square Test",
   "definition": "A statistical test that asks whether the answers differ from what random choosing would give."
  },
  {
   "id": "significant",
   "term": "Significant",
   "definition": "Unlikely to be due to chance alone (here, p below .05). It does not mean large or important."
  },
  {
   "id": "standardised-residual",
   "term": "Standardised Residual",
   "definition": "A score for one pairing. Above +2 means chosen more than chance predicts; below −2, less."
  },
  {
   "id": "child-computer-interaction",
   "term": "Child–Computer Interaction (CCI)",
   "definition": "The field that studies how children use and are affected by technology."
  }
 ],
